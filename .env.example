# SQLite file for the local demo (relative to prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# 32+ character secret used to sign the session cookie
SESSION_SECRET="replace-with-a-long-random-string-at-least-32-chars"

# Which mediator writes the notices: auto (default) | local | claude | gemini
# auto = Claude if ANTHROPIC_API_KEY is set, else Gemini if GEMINI_API_KEY is set,
# else the built-in mediator (no key needed). If a remote AI fails, the built-in one takes over.
MEDIATOR_PROVIDER="auto"

# Optional: Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=""
# CLAUDE_MODEL="claude-opus-5-5"

# Optional: Gemini, which has a free tier. Create a key at https://aistudio.google.com/apikey
# To always use Gemini, also set MEDIATOR_PROVIDER="gemini" above.
# Test it with: npm run ai:check
GEMINI_API_KEY=""
# Check the current Flash model name in AI Studio; this default may change.
# GEMINI_MODEL="gemini-3.1-flash-lite"
